# =============================================================================
# EchoFlow — VPS Production Environment Template
#
# Copy to .env and fill in real values:   cp .env.vps.example .env
# NEVER commit the real .env — it is gitignored.
#
# VPS services: db, redis_broker, redis_cache, web, celery, celery_feed, celery_beat, nginx
# The heavy media worker (celery_media) runs on the laptop — see .env.laptop.example
# =============================================================================

# --- Django ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False

# Must include every host the nginx terminator is reached at.
# Cloudflare Tunnel exposes api.echoflow.in — nginx receives requests for that host.
DJANGO_ALLOWED_HOSTS=api.echoflow.in,media.echoflow.in

# CORS: only the Cloudflare Pages frontend can make browser requests.
DJANGO_CORS_ALLOWED_ORIGINS=https://app.echoflow.in

# --- Database ---
# Direct connection to db container (no pgbouncer). Fixed IP: 172.28.0.4
DB_NAME=echoflow_db
DB_USER=echoflow
DB_PASSWORD=change-me-strong-password
# DB_HOST/DB_PORT: where the app connects. In docker-compose.vps.yml this is
# the `db` service on 5432 — the VPS stack ships no pgbouncer.
#
# DATABASE_URL is NOT set here on purpose, and the four values above are the
# ONLY copy of the credentials. docker compose does not expand ${...} inside
# an env file, so a self-referential value there would arrive literally;
# every service therefore builds it in its `environment:` block as
#   DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# This file used to ALSO carry a hand-written
# `DATABASE_URL=postgres://echoflow:change-me-strong-password@db:5432/echoflow_db`,
# which meant the password existed twice and could silently diverge from
# DB_PASSWORD — change one, forget the other, and nothing fails loudly.
# docker-compose.vps.yml and docker-compose.laptop.yml now build it from DB_*.
# Change these four, not a URL.
DB_HOST=db
DB_PORT=5432
# READ_DATABASE_URL: OPTIONAL streaming-replica URL. Set it to activate
# read/write splitting (backend/app/db_routers.py ReadRouter, auto-enabled by
# the mere presence of this var). Leave BLANK/absent unless a replica is
# actually provisioned — an unreachable value is not a fallback, every read
# raises. See docs/EXPLAIN/database/05-read-replica-design.md.
# An EMPTY value is safe and means "off": the activation check is
# `if os.environ.get('READ_DATABASE_URL')`, i.e. truthy.
READ_DATABASE_URL=

# --- Redis ---
# Broker: shared between VPS workers and laptop worker via Tailscale (172.28.0.2)
# Cache: VPS-only. Laptop does not use redis_cache.
# Generate: openssl rand -base64 32
REDIS_BROKER_PASSWORD=change-me-strong-password
REDIS_CACHE_PASSWORD=change-me-strong-password
REDIS_BROKER_URL=redis://:change-me-strong-password@redis_broker:6379/0
REDIS_CACHE_URL=redis://:change-me-strong-password@redis_cache:6379/0

# --- Cloudflare R2 Object Storage ---
# R2 API token with Object Read & Write scoped to the bucket.
AWS_ACCESS_KEY_ID=change-me-r2-access-key
AWS_SECRET_ACCESS_KEY=change-me-r2-secret
AWS_STORAGE_BUCKET_NAME=echoflow-media

# Cloudflare R2 endpoint. Format: https://<accountid>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=https://change-me-accountid.r2.cloudflarestorage.com

# R2 uses custom region 'auto' for the S3 API.
# security: settings.py:495 allows 'auto' in the region allowlist.
AWS_S3_REGION_NAME=auto

# Seconds a signed upload URL stays valid before it must be re-signed.
AWS_S3_QUERYSTRING_EXPIRE=3600

# PUBLIC hostname for HLS playback. Browser reaches this URL directly (Cloudflare
# Custom Domain → Worker → R2). Must be https:// — HLS.js will refuse to load
# segments over HTTP on an https page.
# When HLS token protection ships, media.echoflow.in points to a Worker
# (not R2 directly). See docs/EXPLAIN/storage/04-hls-token-protection.md.
PUBLIC_MEDIA_ENDPOINT_URL=https://media.echoflow.in

# PUBLIC_HLS_ENDPOINT_URL: the origin browsers (and the mobile app) fetch HLS
# playlists and segments from. In this deployment that is the Worker edge at
# media.echoflow.in, NOT the object store.
#
# REQUIRED, not optional, and a missing value here is a silent outage: with
# this unset, HLS_URL_STYLE falls back to "bucket" and Django emits
#   https://media.echoflow.in/echoflow-media/hls/<id>/master.m3u8
# but the Worker rejects any path that does not start with /hls/ (an edge
# fronting the bucket does not expose the bucket as a path segment), so every
# playlist 404s and nothing else fails.
#
# Must not be collapsed into PUBLIC_MEDIA_ENDPOINT_URL: presigned
# uploads/<original> URLs genuinely need the bucket in the path, and the edge
# serves nothing but /hls/*.
PUBLIC_HLS_ENDPOINT_URL=https://media.echoflow.in
# Set explicitly rather than relying on the "edge if PUBLIC_HLS_ENDPOINT_URL
# is set" default. Both values are declared here so that changing one without
# the other is visible in review.
HLS_URL_STYLE=edge

# --- HLS playback token (short-lived play tokens for HLS streams) ---
# CRITICAL: This same value must be set as a Cloudflare Worker secret
# (via: npx wrangler secret put MEDIA_TOKEN_SECRET). The Worker and Django
# must share this secret for HMAC validation to succeed.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MEDIA_TOKEN_SECRET=change-me-to-a-long-random-string
MEDIA_TOKEN_TTL_SECONDS=600
# The cookie Domain attribute — set so the cookie covers both api.echoflow.in
# and media.echoflow.in. The API sets this cookie on playback-token response.
MEDIA_TOKEN_COOKIE_DOMAIN=.echoflow.in

# --- Share links (A4) ---
# SHARE_TOKEN_TTL_SECONDS: lifetime of the long-lived `?s=` token minted by
# POST /clips/<id>/share-link/. Deliberately NOT MEDIA_TOKEN_TTL_SECONDS
# (600s is sized for a stream that is playing right now); a shared link has to
# survive being passed around in a chat app.
# The code default is 30 * 24 * 3600 = 2592000 (30 days). NOTE: that default
# was never explicitly chosen by an operator — it is a silent default that has
# never been set in any env file. It is the ceiling on exposure, because `exp`
# is the ONLY automatic revocation this design has: a share token is an
# ordinary media token with a longer life, and nothing can invalidate one
# already in someone's hand. Shorten it if a 30-day window is too wide.
SHARE_TOKEN_TTL_SECONDS=2592000
# PUBLIC_APP_BASE_URL: the origin shared clip links point at — the FRONTEND
# (Cloudflare Pages), NOT the API and NOT the media edge. Prepending
# PUBLIC_MEDIA_ENDPOINT_URL / PUBLIC_HLS_ENDPOINT_URL to a share link is a bug:
# the media origin is deliberately edge-shaped and bucket-less.
# This is NOT optional in production: with it blank,
# POST /clips/<id>/share-link/ returns "url": null and hands the raw 30-day
# token in the response body, so the bearer token becomes the only thing a
# client has to work with. Set it to the Pages origin, e.g.
# https://app.echoflow.in  (no trailing slash — settings.py rstrips it).
PUBLIC_APP_BASE_URL=https://app.echoflow.in

# --- HuggingFace ---
# Not needed on VPS (no media processing). Required on laptop for the media image build.
HF_TOKEN=

# --- Gunicorn tuning ---
# 2 workers on 4 GB VPS (each worker ~250 MB + threads for concurrency)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# --- Sentry ---
# Optional. Leave SENTRY_DSN blank to disable.
# WARNING: this key IS present in the template but ships EMPTY, so a deploy
# copied from this file starts with ZERO error capture and no warning at
# startup — init_sentry() returns early on a falsy DSN by design. Fill it in
# with the DSN from sentry.io (free tier works) or accept that this
# environment is unmonitored. The blank is intentional (Sentry is optional);
# the silence is not.
#
# Note the second gate: init_sentry() also returns early when
# DJANGO_DEBUG=true, so leaving DJANGO_DEBUG=True above silently disables
# error capture even with a valid DSN (backend/EchoFlow/sentry.py:26).
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05

# --- Scrapers ---
# SECURITY: the importer is OFF unless you set SCRAPER_ENABLED=True. It is the
# only writer of AudioClip.is_noncommercial / requires_share_alike, which are
# the only input to the feed rights gate and to
# POST /media/playback-token/<uuid>/. A client's own upload cannot declare
# those flags, so this switch is what keeps third-party content out of the
# catalog. Leaving it unset runs on the code default False — fail-closed, but
# by accident rather than by configuration. Set it EXPLICITLY so a deploy
# that means to scrape says so in review, and one that does not, does not.
# Entry points: `manage.py scrape_audio` and the `scrape_and_import` Celery
# task (tasks.py:1168), both of which raise unless this is True.
# Read docs/EXPLAIN/scraping/03-licensing-safety.md first.
SCRAPER_ENABLED=False
# NC content: imported into the catalog but excluded from all feed queries,
# suggestions, and playback tokens while this is False. Turning it on admits
# non-commercial audio to the feed — a product/commercial decision, not a
# technical one.
SCRAPER_ALLOW_NC=False
# ShareAlike: CC-BY-SA items are imported with requires_share_alike=True and
# moderation_approved=False, so each needs an operator call to
# POST /clips/<uuid>/approve-moderation/ before it can reach a feed.
SCRAPER_ALLOW_SHARE_ALIKE=False
# Only needed by the freesound connector (the only source that classifies a
# licence today; wikimedia / internet_archive / kaggle emit no `license` key
# and normalise to UNKNOWN, which the fail-closed allow-list skips).
FREESOUND_API_KEY=

# --- Seed script (manual ops only) ---
# Bearer token for backend/scripts/seed_db.py. Not read by the app or by any
# Celery task; only needed if you bootstrap the catalog by hand.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SEED_AUTH_TOKEN=

# --- RevenueCat (Pro subscription management) ---
# The VPS serves GET /subscription/, POST /subscription/sync/,
# GET /subscription/manage/ and POST /webhooks/revenuecat/, so this block is
# live here — it was previously absent from this template entirely, which
# meant a VPS operator had no way to discover these keys existed.
# SECURE: REVENUECAT_SECRET_KEY is backend-only. Never expose to frontend;
# only REVENUECAT_PUBLIC_KEY is safe for the browser/mobile SDK.
REVENUECAT_SECRET_KEY=
REVENUECAT_PUBLIC_KEY=
REVENUECAT_PROJECT_TOKEN=
REVENUECAT_ENTITLEMENT_ID=pro
# Poll interval in minutes (default: 360 = 6 hours)
REVENUECAT_SYNC_INTERVAL_MINUTES=360
# Webhook secret (Phase 2 — HMAC verification is inert until this is set)
REVENUECAT_WEBHOOK_SECRET=
# Free-tier usage limits
REVENUECAT_DAILY_UPLOAD_LIMIT_FREE=5
REVENUECAT_UPLOAD_MAX_SIZE_MB_FREE=10
REVENUECAT_CLIP_DURATION_LIMIT_FREE=60
REVENUECAT_HD_QUALITY_BLOCKED_FREE=True

# --- Regulatory / Compliance (IT Rules 2021 / DPDP Act 2023 / CERT-In 2022) ---
# These are served by the /legal/compliance/ endpoint.
TERMS_VERSIONS=v1.0,v1.1
COMPLIANCE_OFFICER_NAME=EchoFlow Compliance Officer
COMPLIANCE_OFFICER_EMAIL=compliance@echoflow.in
GRIEVANCE_OFFICER_NAME=EchoFlow Grievance Officer
GRIEVANCE_OFFICER_EMAIL=grievance@echoflow.in
NODAL_CONTACT_NAME=EchoFlow Nodal Contact
NODAL_CONTACT_EMAIL=nodal@echoflow.in
# Physical address — not yet exposed in API (open).
# PHYSICAL_ADDRESS=123 EchoFlow Lane, Mumbai, Maharashtra 400001
