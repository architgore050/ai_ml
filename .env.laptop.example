# EchoFlow — Laptop media worker environment template
# Copy to .env and fill in real values:   cp .env.laptop.example .env
#
# The laptop connects to VPS services via Tailscale (private network).
# DATABASE_URL, REDIS_BROKER_URL, REDIS_CACHE_URL all point at VPS container IPs.
#
# DATABASE_URL is not set here — it is BUILT from DB_* by
# docker-compose.laptop.yml so the password has a single source of truth. See
# the Database section below. REDIS_BROKER_URL / REDIS_CACHE_URL are still
# hand-written here, because the Redis passwords contain base64 characters
# that break Kombo URL parsing; that is the deliberate shape documented in
# settings.py resolve_redis_url().

# --- Django ---
DJANGO_SECRET_KEY=<same-as-vps>
# Must match the VPS DJANGO_SECRET_KEY — signed cookies must verify across services.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.echoflow.in

# --- Database (via Tailscale) ---
DB_NAME=echoflow_db
DB_USER=echoflow
DB_PASSWORD=<same-as-vps>
# DB_HOST/DB_PORT: the VPS db container's Tailscale IP (fixed at 172.28.0.4
# in docker-compose.vps.yml) and its port. This worker does NOT use a compose
# service name — the database is on another machine.
#
# DATABASE_URL is NOT set here, and the four values above are the ONLY copy of
# the credentials. docker compose does not expand ${...} inside an env file, so
# a self-referential value there would arrive literally; the service therefore
# builds it in its `environment:` block as
#   DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# This file used to ALSO carry a hand-written
# `DATABASE_URL=postgres://echoflow:<db-password>@172.28.0.4:5432/echoflow_db`,
# which meant the password existed twice and could silently diverge from
# DB_PASSWORD — change one, forget the other, and nothing fails loudly.
# docker-compose.laptop.yml now builds it from DB_*.
DB_HOST=172.28.0.4
DB_PORT=5432

# --- Redis (via Tailscale) ---
# VPS redis_broker container IP is 172.28.0.2
# Must match REDIS_BROKER_PASSWORD from the VPS .env (same password)
REDIS_BROKER_PASSWORD=<same-as-vps>
REDIS_BROKER_URL=redis://:<redis-broker-password>@172.28.0.2:6379/0
# VPS redis_cache container IP is 172.28.0.3
REDIS_CACHE_PASSWORD=<same-as-vps>
REDIS_CACHE_URL=redis://:<redis-cache-password>@172.28.0.3:6379/0

# --- Media storage (Cloudflare R2) ---
AWS_ACCESS_KEY_ID=<your-r2-access-key>
AWS_SECRET_ACCESS_KEY=<your-r2-secret>
AWS_STORAGE_BUCKET_NAME=echoflow-media
AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_QUERYSTRING_EXPIRE=3600

# --- HLS playback token ---
# Must match the VPS value — Django and the Worker share this secret.
MEDIA_TOKEN_SECRET=<same-as-vps>
MEDIA_TOKEN_TTL_SECONDS=600
# Laptop worker doesn't issue tokens; this is for consistency with VPS.
MEDIA_TOKEN_COOKIE_DOMAIN=.echoflow.in

# --- HuggingFace (required for media image build) ---
HF_TOKEN=<your-hf-token>
HF_HUB_OFFLINE=1
HF_HOME=/home/appuser/.cache/huggingface

# --- Field encryption (must match VPS) ---
FIELD_ENCRYPTION_KEY=<same-as-vps>
# Must match the VPS FIELD_ENCRYPTION_KEY — encrypted DB fields must decrypt correctly.

# --- RevenueCat (Pro entitlement sync) ---
# This worker listens on -Q heavy_media only, and no RevenueCat task is routed
# there today, so nothing here is needed to boot or to transcode. Both keys are
# listed anyway, for two reasons:
#   1. The secret is guarded by EchoFlow/secrets.require_real_secret, which
#      refuses documentation values. An absent variable and an empty one are
#      treated identically (empty = "RevenueCat not configured"), so the laptop
#      starts either way — but an operator has no way to discover the key
#      exists if this template never mentions it.
#   2. `sync_revenuecat_entitlements` is not routed to a queue of its own. If it
#      is ever routed to heavy_media, a laptop without these silently uses the
#      code defaults (entitlement "pro") instead of the VPS's configuration.
# Must match the VPS REVENUECAT_SECRET_KEY — it is one credential across the
# fleet. From RevenueCat dashboard -> Project Settings -> API keys.
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT_ID=pro
# Deliberately NOT here, because this worker never reads them:
#   REVENUECAT_PUBLIC_KEY / REVENUECAT_PROJECT_TOKEN — consumed by the
#     browser/mobile SDK, never by Django.
#   REVENUECAT_WEBHOOK_SECRET / REVENUECAT_CUSTOMER_PORTAL_URL — served by the
#     web process on the VPS.
#   REVENUECAT_SYNC_INTERVAL_MINUTES — a Celery Beat schedule; no beat runs here.
#   REVENUECAT_DAILY_UPLOAD_LIMIT_FREE, _UPLOAD_MAX_SIZE_MB_FREE,
#   _CLIP_DURATION_LIMIT_FREE, _HD_QUALITY_BLOCKED_FREE — read by
#     views/content.py, views/subscription.py and serializers.py, all web-only.
