# EchoFlow Mobile — environment
#
# Copy to `.env.local` (gitignored) and edit. Read by app.config.ts at config
# evaluation time, which means the value is baked into the bundle at build time
# — it is NOT read at runtime from the device.
#
# SECURITY: the value must be https. app.config.ts throws at config-evaluation
# time on anything else, and src/api/client.ts throws again on import. That
# double check is deliberate: the old app shipped `http://localhost:8005` as its
# default and nothing complained until a request failed.
#
# `web:8005` is a debug escape hatch that AGENTS.md says to drop. The nginx
# terminator on :443 is the only supported entrypoint.

# --- Local simulator -------------------------------------------------------
# iOS simulator: localhost works, because the simulator shares the host's
# loopback.
EXPO_PUBLIC_API_BASE_URL=https://localhost:18443

# --- Android emulator ------------------------------------------------------
# Uncomment and point at 10.0.2.2 (the emulator's alias for the host loopback).
# EXPO_PUBLIC_API_BASE_URL=https://10.0.2.2:18443

# --- Physical device -------------------------------------------------------
# A phone's `localhost` is the phone. Use the LAN IP of the machine running the
# stack, and note that BOTH ports are needed:
#   EXPO_PUBLIC_API_BASE_URL=https://<LAN-IP>:18443   API   (Django via nginx)
#   PUBLIC_HLS_ENDPOINT_URL  =https://<LAN-IP>:19443   HLS   (MinIO via nginx)
#
# The certificate problem: docker/certs/localhost.crt has SANs
# (localhost, minio, web, nginx, 127.0.0.1, 0.0.0.0) and does NOT cover a LAN
# IP. iOS ATS will reject the connection and Android will show an interstitial.
# Certificate setup is manual and documented, not committed — see
# docs/mobile-rebuild-plan.md §I9 and mobile/README.md.
#
# Until that is solved, only a SIMULATOR can exercise playback. Simulator
# verification is not device verification and must not be reported as such.

# --- RevenueCat ------------------------------------------------------------
# Configure these public SDK keys in the matching EAS environment as well.
# They identify the mobile app to RevenueCat and are safe to bundle; never put
# REVENUECAT_SECRET_KEY in this file or in a mobile build.
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# --- Sentry ---------------------------------------------------------------
# This is the mobile project's public client DSN. Keep the value in EAS for
# preview/production; development remains disabled even when it is present.
# EXPO_PUBLIC_SENTRY_DSN=https://public@example.ingest.sentry.io/123
