# =============================================================================
# EchoFlow — environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit the real .env — it is gitignored.
# =============================================================================

# --- Django ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# NOTE: must be DJANGO_DEBUG, not DEBUG — settings.py reads os.environ.get('DJANGO_DEBUG', ...).
# This was previously named DEBUG here, which silently never matched anything
# Django read, so DEBUG always fell back to False regardless of this file —
# including the /media/ route bug that caused earlier this week.
#
# DECISION (HTTPS): Keep DJANGO_DEBUG=False for any environment that fronts
# Django with a TLS terminator (nginx, ALB, Cloudflare). The `if not DEBUG:`
# block in settings.py:529 then activates SECURE_SSL_REDIRECT, HSTS, and
# SECURE_PROXY_SSL_HEADER. Setting DEBUG=True locally in this setup makes
# the nginx → gunicorn hop look like plain HTTP to Django and breaks the
# X-Forwarded-Proto contract.
DJANGO_DEBUG=False
# Comma-separated hosts, e.g. localhost,yourdomain.com
# Include the HTTPS host(s) you intend to use. After HSTS preload, browsers
# will refuse to speak HTTP to these names — plan accordingly.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# "True" to allow all CORS origins (dev only); otherwise set allowed list below
DJANGO_CORS_ALL=False
# Comma-separated origins. With HTTPS terminator live, every browser-reachable
# origin must be https:// — a single http:// here causes mixed-content or
# CORS preflight failures on otherwise-correct requests.
DJANGO_CORS_ALLOWED_ORIGINS=https://localhost:3000,https://localhost:5173,https://localhost:3021

# --- Database (Docker service name = db; non-Docker dev hits localhost directly) ---
# In Docker compose, web/celery go through the pgbouncer service (see below),
# which forwards to the `db` container. Non-Docker dev (`pip install + runserver`)
# connects to localhost:5432 directly with no pgbouncer in the path.
DB_NAME=echoflow_db
DB_USER=echoflow
DB_PASSWORD=change-me-strong-password
# DB_HOST/DB_PORT: where the app connects. In docker-compose.yml this is the
# pgbouncer service (see below), which forwards to `db`. In
# docker-compose.local.yml it is `db_local` directly, bypassing pgbouncer.
# Non-Docker dev: localhost / 5432.
DB_HOST=pgbouncer
DB_PORT=6432
# DATABASE_URL is NOT set here on purpose: docker compose does not expand
# ${...} inside an env file, so a self-referential value would arrive
# literally. Every service builds it in its `environment:` block as
#   DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# so the URL and the four values above can never disagree. Change those, not
# the URL.
# DATABASE_URL=
# Test database. conftest.py creates it if missing and points the suite at it.
# It must exist on the POSTGRES server directly, not via pgbouncer: pgbouncer
# whitelists only DB_NAME, so CREATE DATABASE through it is refused.
TEST_DB_NAME=echoflow_test
# Where conftest reaches postgres for those admin statements. Separate from
# DB_HOST because the app may go through pgbouncer while the test harness must
# not. Never point this at a non-local host: conftest issues CREATE/DROP
# DATABASE and CREATE EXTENSION against it.
TEST_DB_HOST=db
TEST_DB_PORT=5432

# --- Redis ---
# Two Redis instances in Docker compose: `redis_broker` for Celery queues
# (noeviction policy, can't lose queued tasks) and `redis_cache` for the Django
# cache + per-user feed lists + telemetry queue (LRU eviction is OK because
# refill_user_feed and flush_telemetry are idempotent).
#
# Non-Docker dev: leave REDIS_BROKER_URL / REDIS_CACHE_URL unset and set
# REDIS_URL to a single Redis on localhost — settings.py falls back to it
# when the split vars are absent.
REDIS_URL=redis://localhost:6379/1
# REDIS_BROKER_URL=redis://redis_broker:6379/0
# REDIS_CACHE_URL=redis://redis_cache:6379/0

# --- Media storage (S3-compatible object storage) ---
# Local dev: these defaults point at the `minio` service in docker-compose.yml.
# Production: point AWS_S3_ENDPOINT_URL at real S3 (leave blank) or R2/other,
# and use real credentials + bucket. This is the ONLY thing that changes
# between environments — there is no separate filesystem-storage code path.
AWS_ACCESS_KEY_ID=change-me-s3-access-key
AWS_SECRET_ACCESS_KEY=change-me-s3-secret-key
AWS_STORAGE_BUCKET_NAME=echoflow-media
# Leave blank for real AWS S3. Set for MinIO/R2/other S3-compatible hosts.
# App containers reach MinIO over the compose network, hence the service
# name (not localhost) — localhost:9000 is only for tools running on your host.
# SECURITY: AWS_S3_ENDPOINT_URL stays HTTP because this URL is what CONTAINERS
# use to talk to MinIO over the in-network docker bridge. The PUBLIC_MEDIA_ENDPOINT_URL
# below is what BROWSERS use; that one is HTTPS so hls.js can load segments
# without tripping the browser's mixed-content blocker.
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=ap-south-1  # Must be ap-south-1 or ap-south-2 for DPDP cross-border + RBI localisation compliance (settings.py:467)
# Seconds a signed playback URL stays valid before it must be re-signed.
AWS_S3_QUERYSTRING_EXPIRE=3600

# PUBLIC_MEDIA_ENDPOINT_URL: the HTTPS origin a browser reaches for HLS
# segments. With the nginx TLS terminator in front of MinIO, this is the
# nginx 9443 listener. Leave blank to fall back to AWS_S3_ENDPOINT_URL
# (useful for a real-S3 deployment where internal and public endpoints
# are the same).
PUBLIC_MEDIA_ENDPOINT_URL=https://localhost:9443

# PUBLIC_HLS_ENDPOINT_URL: the origin a BROWSER uses for HLS playlists and
# segments, when that is the VALIDATING EDGE rather than the object store --
# i.e. the Cloudflare Worker on media.echoflow.in, or the Worker behind the
# nginx :9443 listener locally. Leave blank when there is no edge in front of
# the bucket (plain S3/MinIO), in which case it falls back to
# PUBLIC_MEDIA_ENDPOINT_URL.
#
# Setting this ALSO flips HLS_URL_STYLE to "edge", which makes the emitted
# URLs bucket-less (https://.../hls/<id>/master.m3u8 instead of
# https://.../<bucket>/hls/<id>/master.m3u8). That is required, not cosmetic:
# an edge fronting the bucket does not expose the bucket as a path segment,
# and the Worker rejects any request path that does not start with /hls/.
# Set HLS_URL_STYLE explicitly ("edge" or "bucket") to override the default.
#
# It must NOT be collapsed into PUBLIC_MEDIA_ENDPOINT_URL: presigned
# uploads/<original> URLs still need the bucket in the path, and the edge
# serves nothing but /hls/*.
PUBLIC_HLS_ENDPOINT_URL=

# --- HLS playback token (short-lived play tokens for HLS streams) ---
# SECRETS: this HMAC signing key is shared between Django (token issuance)
# and the Cloudflare Worker (token validation). If they differ, every
# playback request 403s with no other symptom.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# In production, the same value must be set as a Cloudflare Worker secret
# (via: npx wrangler secret put MEDIA_TOKEN_SECRET). For local dev,
# scripts/run-hls-worker-local.sh generates the Worker's .dev.vars from this
# value so the two cannot drift.
# See docs/EXPLAIN/storage/04-hls-token-protection.md for the full design.
MEDIA_TOKEN_SECRET=change-me-to-a-long-random-string
# Token time-to-live in seconds. 600 = 10 minutes. Also sets the cookie's
# Max-Age, so the browser never holds a token longer than it is valid for.
MEDIA_TOKEN_TTL_SECONDS=600
# Cookie Domain attribute for the HLS token cookie.
# Leave empty for dev: the API and the media origin are both `localhost`
# (cookies are host-scoped and ignore ports), and localhost rejects domain
# cookies.
# REQUIRED in production when PUBLIC_HLS_ENDPOINT_URL is a different host
# from the API (api.echoflow.in issuing for media.echoflow.in): a host-only
# cookie is never sent to the media host, so every request 403s. Set the
# shared parent domain, e.g. ".echoflow.in".
MEDIA_TOKEN_COOKIE_DOMAIN=

# --- HuggingFace (media image model baking / offline runtime) ---
HF_TOKEN=

# --- OpenAI (optional — reserved pipeline branch) ---
OPENAI_API_KEY=

# --- Scrapers ---
SCRAPER_USER_AGENT=EchoFlowScraper/1.0
SCRAPER_CONTACT_EMAIL=
SCRAPER_DEFAULT_CLIP_SECONDS=300
SCRAPER_MAX_DOWNLOADS_PER_MIN=30
SCRAPER_ALLOW_LICENSES=CC0,CC-BY,CC-BY-SA,CC-BY-NC
FREESOUND_API_KEY=
SCRAPER_KAGGLE_LOCAL_PATH=

# --- Upload validation ---
# Max audio duration for user uploads in seconds. Default 300 (5 min).
# EchoFlow is short-form audio; matches SCRAPER_DEFAULT_CLIP_SECONDS.
MAX_DURATION_SECONDS=300

# --- Seed script ---
SEED_AUTH_TOKEN=
# After the nginx TLS terminator, the API lives at https://localhost (port
# implied). The old http://localhost:8005 URL pointed at the in-container
# gunicorn directly and is no longer the supported path.
SEED_API_URL=https://localhost/clips/

# --- Sentry (optional; leave SENTRY_DSN blank to disable) ---
# Sentry captures uncaught exceptions from views + Celery tasks. The
# SDK is initialized only when DJANGO_DEBUG=False AND SENTRY_DSN is
# set, so dev/test environments are unaffected.
SENTRY_DSN=
SENTRY_ENV=production
# 10% traces by default. Raise to 1.0 in low-traffic envs to capture
# every transaction; lower to 0.01 in high-traffic envs to control
# quota.
SENTRY_TRACES_SAMPLE_RATE=0.1
# 5% profiling by default. Profiling requires the
# sentry_profiles_sample_rate to also be set; 0 disables profiling.
SENTRY_PROFILES_SAMPLE_RATE=0.05

# --- Gunicorn tuning ---
GUNICORN_WORKERS=4
GUNICORN_THREADS=4

# --- Regulatory / Compliance (IT Rules 2021 / DPDP Act 2023 / CERT-In 2022) ---
TERMS_VERSIONS=v1.0,v1.1  # Comma-separated consent versions (settings.py:622)
COMPLIANCE_OFFICER_NAME=EchoFlow Compliance Officer
COMPLIANCE_OFFICER_EMAIL=compliance@echoflow.in
GRIEVANCE_OFFICER_NAME=EchoFlow Grievance Officer
GRIEVANCE_OFFICER_EMAIL=grievance@echoflow.in
NODAL_CONTACT_NAME=EchoFlow Nodal Contact
NODAL_CONTACT_EMAIL=nodal@echoflow.in
# Physical address (IT Rules 2021 / Consumer Protection) — not yet exposed in /legal/compliance/ endpoint (open).
# PHYSICAL_ADDRESS=123 EchoFlow Lane, Mumbai, Maharashtra 400001

# --- RevenueCat (Pro subscription management) ---
# SECURE: REVENUECAT_SECRET_KEY is backend-only. Never expose to frontend.
# Get it from your RevenueCat dashboard → Project Settings → API keys.
REVENUECAT_SECRET_KEY=
# Public key for the frontend SDK (@revenuecat/purchases-js). Safe to expose.
REVENUECAT_PUBLIC_KEY=
REVENUECAT_PROJECT_TOKEN=
REVENUECAT_ENTITLEMENT_ID=pro
# Poll interval in minutes (default: 360 = 6 hours)
REVENUECAT_SYNC_INTERVAL_MINUTES=360
# RevenueCat Customer Portal URL (leave blank for default)
REVENUECAT_CUSTOMER_PORTAL_URL=
# Webhook secret (Phase 2 — configure when enabling webhooks)
REVENUECAT_WEBHOOK_SECRET=
# Free-tier usage limits
REVENUECAT_DAILY_UPLOAD_LIMIT_FREE=5
REVENUECAT_UPLOAD_MAX_SIZE_MB_FREE=10
REVENUECAT_CLIP_DURATION_LIMIT_FREE=60
REVENUECAT_HD_QUALITY_BLOCKED_FREE=True

# --- Grafana (docker compose provisions Grafana from this env) ---
# Grafana v11 refuses to start without a non-empty GF_SECURITY_ADMIN_PASSWORD.
# Compose binds $GRAFANA_ADMIN_PASSWORD into the Grafana container; keep this
# value in sync if you rotate the Grafana admin password post-deploy.
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password

# --- RevenueCat (mobile subscription integration — reserved, not yet wired) ---
# These keys are NOT currently read by any settings.py / views / services code.
# Kept here as a placeholder for the eventual subscription integration
# (webhook receiver + receipt validation). Leave blank until that work lands.
REVENUECAT_SECRET_KEY=
REVENUECAT_PUBLIC_KEY=
REVENUECAT_PROJECT_TOKEN=
SENTRY_DSN=
SENTRY_ENV=production
# 10% traces by default. Raise to 1.0 in low-traffic envs to capture
# every transaction; lower to 0.01 in high-traffic envs to control
# quota.
SENTRY_TRACES_SAMPLE_RATE=0.1
# 5% profiling by default. Profiling requires the
# sentry_profiles_sample_rate to also be set; 0 disables profiling.
SENTRY_PROFILES_SAMPLE_RATE=0.05

GRAFANA_ADMIN_PASSWORD=admin-password
GRAFANA_ADMIN_PASSWORD=admin-password
REDIS_URL=redis://redis_broker:6379/1
