# EchoFlow Frontend Environment
# Copy this to .env.local and adjust

# Backend API base URL. After the nginx TLS terminator ships, the API is
# served at https://localhost (port 443 implicit). The bare-IP + :8005 form
# bypassed nginx and spoke plain HTTP to gunicorn — that path is deprecated.
# For a remote deployment replace `localhost` with the host serving the
# nginx cert (e.g. https://api.echoflow.example).
VITE_API_BASE_URL=https://localhost
# Force demo mode regardless of backend availability
VITE_DEMO_MODE=false